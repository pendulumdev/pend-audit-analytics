# Treat a dependency's `engines` mismatch as an error, not a warning.
#
# Without this, npm prints EBADENGINE and exits 0, so CI happily went green on a
# dependency requiring Node >=22.12 while this package advertised >=20. A
# published CLI cannot claim a runtime it warns on. Failing the install is the
# only version of this check that cannot be overlooked.
engine-strict=true
